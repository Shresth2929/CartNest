# CartNest Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database connection (Neon / PostgreSQL)
# Example for local: postgresql://postgres:postgres@localhost:5432/cartnest?schema=public
# Example for Neon: postgresql://[user]:[password]@[endpoint].neon.tech/cartnest?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cartnest?schema=public"

# Authentication
JWT_SECRET="cartnest_secure_jwt_secret_key_student_demo_2026"
JWT_EXPIRES_IN="7d"

# Frontend Client URL for CORS
CLIENT_URL="http://localhost:5173"

# Seed default demo accounts
ADMIN_EMAIL="admin@cartnest.com"
ADMIN_PASSWORD="AdminPassword123!"
DEMO_CUSTOMER_EMAIL="customer@cartnest.com"
DEMO_CUSTOMER_PASSWORD="CustomerPassword123!"
