# CartNest Backend Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL connection. Replace the username and password with local values.
DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/cartnest?schema=public"

# Generate a unique secret locally, for example with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# Frontend origin allowed by CORS
CLIENT_URL="http://localhost:5173"

# Local-only demo accounts created by the seed script. Set unique passwords locally.
ADMIN_EMAIL="admin@cartnest.test"
ADMIN_PASSWORD=""
DEMO_CUSTOMER_EMAIL="customer@cartnest.test"
DEMO_CUSTOMER_PASSWORD=""
